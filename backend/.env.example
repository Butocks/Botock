# Google Account Credentials for automated Flow AI login
# IMPORTANT: Never commit your real credentials to GitHub!
# Keep this file as a template only. Put real keys in .env
GOOGLE_EMAIL=your_email@gmail.com
GOOGLE_PASSWORD=your_app_password

# Session settings
SESSION_MAX_AGE_HOURS=12

# Video generation timeout (seconds) — 10 min default
VIDEO_GEN_TIMEOUT=600

# Groq API Key
GROQ_API_KEY=your_groq_api_key
