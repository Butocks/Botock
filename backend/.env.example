# ==============================================================================
# BOTOCK BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the values for your environment.
# NEVER commit your actual .env file or real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME="Botock AI Creative Suite"

# Supabase Project Configuration (PostgreSQL Database & Auth)
SUPABASE_URL=https://bumojafxwqukycgahmmd.supabase.co
# Anon key — get this from Supabase Dashboard -> Project Settings -> API -> anon/public
SUPABASE_ANON_KEY=your_supabase_anon_key
# Supabase JWT Secret (from Supabase Dashboard -> Project Settings -> API / Auth)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
# Secret key for token signing & sessions
SECRET_KEY=your_random_secret_key_for_sessions_and_tokens

# ------------------------------------------------------------------------------
# 2. AI SERVICES (GROQ & FLOW AI / GOOGLE)
# ------------------------------------------------------------------------------
# Groq API Key (for LLM chat / prompt expansion / text operations)
GROQ_API_KEY=your_groq_api_key

# Google Account Credentials for automated Flow AI video generation
GOOGLE_EMAIL=your_email@gmail.com
GOOGLE_PASSWORD=your_app_password

# Required Fernet encryption key to encrypt local Flow browser session cookies at rest.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=replace_with_a_fernet_key

# Session & Generation Limits
SESSION_MAX_AGE_HOURS=720
VIDEO_GEN_TIMEOUT=600
PAGE_LOAD_TIMEOUT=60

# ------------------------------------------------------------------------------
# 3. ADMIN SECURITY & OTP LOGIN
# ------------------------------------------------------------------------------
# Comma-separated admin emails
ADMIN_EMAILS=info@botock.app
# Secret passphrase required on the admin login page
ADMIN_LOGIN_SECRET=your_strong_admin_passphrase
ADMIN_OTP_EXPIRY_MINUTES=10
ADMIN_MAX_OTP_CYCLES=3

# ------------------------------------------------------------------------------
# 4. EMAIL / SMTP SETTINGS (Zoho Mail default)
# ------------------------------------------------------------------------------
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=587
SMTP_USER=info@botock.app
SMTP_PASSWORD=your_zoho_smtp_password
SMTP_FROM_EMAIL=Botock <info@botock.app>
SMTP_USE_SSL=False

# ------------------------------------------------------------------------------
# 5. USER CREDITS & CONCURRENCY
# ------------------------------------------------------------------------------
MAX_BROWSER_INSTANCES=2
MAX_FFMPEG_WORKERS=1
FREE_DAILY_CREDITS=50
VIDEO_CREDIT_COST=15
IMAGE_CREDIT_COST=5
FREE_DAILY_VIDEO_LIMIT=3
FREE_DAILY_IMAGE_LIMIT=5

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED WORKER CONTROL PLANE (Set on Azure / Control Plane only)
# ------------------------------------------------------------------------------
# Set to 'true' on Azure VM when running as the central job coordinator
DISTRIBUTED_QUEUE_ENABLED=false

# Supabase direct PostgreSQL connection string (Session Mode port 5432 or Transaction pooler 6543)
QUEUE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.bumojafxwqukycgahmmd.supabase.co:5432/postgres?sslmode=require

# Worker Tokens Mapping (JSON format: worker-id -> hashed token & account tag)
# Example: {"laptop-worker": {"token_hash": "...", "account_id": "laptop"}, "colab-worker": {"token_hash": "...", "account_id": "colab"}}
WORKER_TOKENS_JSON={}

# Leases & Timeouts
MAX_PENDING_VIDEO_JOBS=50
WORKER_LEASE_SECONDS=900
WORKER_HEARTBEAT_SECONDS=30
MAX_JOB_ATTEMPTS=2
MAX_WORKER_UPLOAD_BYTES=100000000

# Azure Blob Storage (Optional if videos are stored directly in cloud)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_VIDEO_CONTAINER=botock-videos

# Optional Proxy & Webhook
ALERT_WEBHOOK_URL=
PROXY_SERVER=
PROXY_USER=
PROXY_PASS=
