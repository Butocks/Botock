# ==============================================================================
# BOTOCK FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local
# ==============================================================================

# Public Site Domain (Production or Local)
NEXT_PUBLIC_SITE_URL=https://botock.app

# Backend API URLs
# 1. Main Cloud Backend (e.g. Azure VM or App Service: http://<AZURE_IP>:8000)
NEXT_PUBLIC_BACKEND_URL=https://api.botock.app
NEXT_PUBLIC_API_URL=https://api.botock.app

# 2. Local Laptop Tunnel URL (Optional fallback when running backend locally)
NEXT_PUBLIC_LAPTOP_BACKEND_URL=

# Supabase Auth & Client Keys (Found in Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://bumojafxwqukycgahmmd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin Email Access List
NEXT_PUBLIC_ADMIN_EMAILS=info@botock.app

# Google OAuth Client ID (for Google Sign-In button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

