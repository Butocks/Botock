<file path="frontend/app/tools/video-trim/error.tsx">
"use client";

import { useEffect } from "react";
import { AlertTriangle, RotateCcw } from "lucide-react";
import FFmpegManager from "@/lib/ffmpeg/ffmpegManager";

interface ErrorProps {
  error: Error & { digest?: string };
  reset: () => void;
}

export default function VideoTrimError({ error, reset }: ErrorProps) {
  useEffect(() => {
    console.error("Video Trim Tool crashed:", error);
  }, [error]);

  const handleReset = async () => {
    try {
      await FFmpegManager.terminate();
    } catch {
      // Ignore termination error on reset
    }
    reset();
  };

  return (
