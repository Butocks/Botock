  });

  const handleReset = () => {
    cancelRef.current.cancelled = true;
    
    setFile(null);
    setPageCount(null);
    setResults(null);
    setEditableText("");
    setProgressPercent(0);
    setProgressStatus("");
    setError(null);
    setCopiedAll(false);
