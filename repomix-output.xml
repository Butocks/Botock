                />
              </div>

              {/* Duration Segmented Pills & Aspect Ratio */}
              <div className="space-y-4 pt-1">
                {/* Duration */}
                <div>
                  <div className="flex items-center justify-between mb-1.5">
                    <label className="text-xs font-bold text-slate-900 dark:text-white">
