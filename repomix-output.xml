          {/* Left Column: Contact Form (Takes 7 cols) */}
          <div className="lg:col-span-7 rounded-2xl bg-white dark:bg-[#111114] border border-slate-200 dark:border-white/[0.08] p-6 sm:p-8">
            {status === "success" ? (
              <div className="py-12 text-center space-y-4">
