    .split(",")
    .map((e) => e.trim().toLowerCase());
  const isUserAdmin = user && envAdmins.includes(user?.email?.toLowerCase() || "");

  useEffect(() => {
    supabase.auth.getUser().then(({ data }) => {
      setUser(data.user);
    });

