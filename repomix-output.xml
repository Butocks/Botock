    e.preventDefault();
    if (!formData.name || !formData.email || !formData.message) {
      alert("Please complete all required fields.");
      return;
    }

    setStatus("sending");
    setTimeout(() => {
      const generatedId = `BTK-${Math.floor(100000 + Math.random() * 900000)}`;
      setTicketId(generatedId);
      setStatus("success");
