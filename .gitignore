# Dependencies
node_modules/
venv/
backend/venv/
.pnpm-store/

# Next.js build output
.next/
out/
dist/
build/

# Environment files (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Session & credentials (CRITICAL: NEVER COMMIT)
backend/session/
session/
*.session.json
*.json.lock
*.tmp.*
admin_tokens.json
admin_lockout.json
otp_store.json
otp_rate_limits.json

# Video & debug storage
backend/generated_videos/
generated_videos/
backend/*.mp4
backend/*.png
backend/*.jpg
backend/*.log
*.log
scratch/

# Allow public images in frontend
!frontend/public/**

# Python cache & temporary files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

